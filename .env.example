# Copia a .env y rellena con valores del panel: Project Settings → API
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_ANON_PUBLIC_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_ANON_PUBLIC_KEY"

# Local (Docker + Supabase CLI): usa archivo .env.local — ver Docs/LOCAL_SUPABASE.md
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<salida de npm run supabase:status>
# VITE_SUPABASE_PROJECT_ID=conexionfit
